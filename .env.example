# 👈 لازم يكون بالظبط الدومين اللي هتنشر عليه السيرفر (مثلاً على Vercel:
# https://hungry-backend-alpha.vercel.app) وإلا صور المنتجات مش هتظهر
PUBLIC_BASE_URL=https://your-app.vercel.app

# 👈 جديد: لازم تعمل حساب مجاني على https://cloudinary.com وتحط بياناتك
# هنا عشان رفع صورة البروفايل يفضل شغال بعد الرفع (تفاصيل في upload.js)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
